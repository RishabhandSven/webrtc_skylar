# nginx.conf
# ==============================================================================
# PURPOSE:
# - Serves the client-side static HTML/CSS/JS files on port 80.
# - Reverse proxies incoming WebSocket signaling traffic (/ws) to the Node.js signaling container.
# 
# RESPONSIBILITIES:
# - Serves static files from '/usr/share/nginx/html'.
# - Matches requests starting with '/ws' and upgrades them from HTTP/1.1 to WebSockets, 
#   routing them to http://signaling:8080.
# 
# INTERACTIONS:
# - Called by: Browsers requesting UI or starting WebSocket connections.
# - Calls: The internal 'signaling' service on port 8080 over the Docker bridge network.
# 
# INTERVIEW ARCHITECTURAL RATIONALE (SDE-1 DEFENSE):
# 1. Why use Nginx as a reverse proxy instead of having the browser talk directly to Node?
#    - Single Entry Point (Port Consolidation). It exposes only a single port (3000 mapped to Nginx's 80)
#      to the user's host. It serves UI files and handles signaling under a single domain. This avoids:
#      - CORS (Cross-Origin Resource Sharing) blockages.
#      - Mixed-content warnings (e.g. HTTPS client trying to contact insecure HTTP/WS on a separate port).
# 2. How does Nginx find the signaling container?
#    - Docker DNS resolution. Docker Compose sets up a shared bridge network. Nginx can resolve
#      the hostname 'signaling' to the signaling container's internal IP address.
# 3. Simpler Alternative:
#    - Serve static files via Node.js Express (bloats the backend; violates SoC).
#    - Expose signaling server directly on port 8081 and have client connect directly (causes CORS concerns).
# 4. Production Alternative:
#    - SSL Termination at Nginx (using Let's Encrypt certificates), Gzip compression, rate limiting, 
#      and horizontal load balancing of WebSockets using ip_hash to route clients of the same room 
#      to the same server instance (if Redis is not used).
# ==============================================================================

events {
    # Default event configuration. Required block by Nginx.
    worker_connections 1024;
}

http {
    # Include MIME types so CSS and JS files are served with correct headers
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Simple log format
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;

    server {
        listen ${PORT};
        server_name localhost;

        # 1. Serve static frontend files
        location / {
            root /usr/share/nginx/html;
            index index.html;
            try_files $uri $uri/ /index.html;
        }

        # 2. Reverse Proxy WebSocket Signaling traffic
        # WebSockets require upgrading the connection headers.
        location /ws {
            # Route to the 'signaling' service defined in docker-compose
            proxy_pass http://${SIGNALING_HOST}:8080;

            # HTTP 1.1 is required for WebSocket keep-alive and connections
            proxy_http_version 1.1;

            # Set connection headers to trigger the HTTP Upgrade handshake
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";

            # Pass original host and client IP headers for server logging
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            
            # Disable buffering for real-time WebSocket messaging
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }
    }
}
